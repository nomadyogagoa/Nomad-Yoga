# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database
# Runtime: Supabase session pooler (port 5432) for the persistent API process.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/nomad_yoga?sslmode=require"
# Required by the runtime Prisma pg adapter. Use the CA certificate downloaded from Supabase.
DATABASE_CA_CERT_PATH="./certs/supabase-ca.crt"
# Prisma migrations and administrative tooling: copy the direct/session URL from Supabase Connect.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/nomad_yoga?sslmode=require"

# Frontend and CORS. FRONTEND_URLS optionally supports comma-separated trusted origins.
FRONTEND_URL="http://localhost:3000"
FRONTEND_URLS=

# Authentication — use a unique secret of at least 32 characters.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
PASSWORD_RESET_EXPIRES_MINUTES=60

# Email — choose resend or smtp; credentials remain optional for local tests.
EMAIL_PROVIDER=resend
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
CONTACT_NOTIFICATION_EMAIL=

# Payments — provider credentials are optional until a live integration is approved.
PAYMENT_GATEWAY=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# Cloudinary media storage (optional until upload integration is enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nomad-yoga
